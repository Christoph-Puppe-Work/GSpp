# GCP Project and GCS Bucket
GOOGLE_CLOUD_PROJECT=gpp-agentic-2
GCS_BUCKET_NAME=gpp-agentic-2-artifacts

# Models
ORCHESTRATOR_MODEL=gemini-3-flash-preview
PRODUCER_MODEL=gemini-3.1-pro-preview
REVIEWER_MODEL=gemini-3-flash-preview
TOOL_AGENT_MODEL=gemini-3.1-flash-lite-preview

# MCP Configuration
MCP_SERVER_URL=http://localhost:8080

# Workflow Settings
MAX_REVIEW_ITERATIONS=3

# Observability
OTEL_DISABLED=0
