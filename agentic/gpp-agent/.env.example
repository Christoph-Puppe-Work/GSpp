# GCP Project, Region
GOOGLE_CLOUD_PROJECT=your-project-id
# Hinweis: app/agent.py erzwingt zur Laufzeit GOOGLE_CLOUD_LOCATION=global —
# Gemini-3-Preview-Modelle werden nur über den global-Endpoint ausgeliefert.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Auth: in Cloud Shell verwendet ADK Application Default Credentials.
# Stelle sicher dass `gcloud auth application-default login` aktiv ist.

# Modelle (Gemini 3.x family — keine 2.5-Fallbacks!)
# Rollenbasierte Auswahl, siehe app/models.py:
#   CLASSIFIER_MODEL / REVIEWER_MODEL → Flash (Classifier + Judges)
#   PRODUCER_MODEL                    → 3.1 Pro (tool-nutzende Inspectors)
# Pro-Knoten-Overrides: PHASE<n>_MODEL, PHASE<n>_JUDGE_MODEL
CLASSIFIER_MODEL=gemini-3-flash-preview
REVIEWER_MODEL=gemini-3-flash-preview
PRODUCER_MODEL=gemini-3.1-pro-preview

# MCP Server (zwei Server: Anwenderkatalog + Backend-State)
ANWENDER_MCP_URL=http://localhost:8080
BACKEND_MCP_URL=http://localhost:8081

# MCP-Client-Timeouts (Sekunden) — großzügig wegen Cloud-Run-Cold-Starts
# MCP_CONNECT_TIMEOUT_S=30
# MCP_SSE_READ_TIMEOUT_S=300

# Observability
OTEL_DISABLED=0
