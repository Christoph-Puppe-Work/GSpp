# GCP Project, Region, Bucket
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=your-location
GOOGLE_GENAI_USE_VERTEXAI=true
GCS_BUCKET_NAME=your-gcs-bucket-name

# Auth: in Cloud Shell verwendet ADK Application Default Credentials.
# Stelle sicher dass `gcloud auth application-default login` aktiv ist.

# Modelle (Gemini 3.x family — keine 2.5-Fallbacks!)
ORCHESTRATOR_MODEL=gemini-3-flash-preview
PRODUCER_MODEL=gemini-3.1-pro-preview
REVIEWER_MODEL=gemini-3-flash-preview
TOOL_AGENT_MODEL=gemini-3.1-flash-lite-preview

# MCP Server (zwei Server: Anwenderkatalog + Backend-State)
ANWENDER_MCP_URL=http://localhost:8080
BACKEND_MCP_URL=http://localhost:8081

# Workflow
MAX_REVIEW_ITERATIONS=3

# Observability
OTEL_DISABLED=0

# Optional: Vertex Sandbox für data_parser. Lokal leer lassen.
# SANDBOX_RESOURCE_NAME=projects/your-project-id/locations/europe-west1/sandboxes/your-sandbox